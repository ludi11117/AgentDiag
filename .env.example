# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
# cp .env.example .env

# ===== 必填 =====
SILICONFLOW_API_KEY=your_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===== 模型（可选，均有默认值）=====
DIAGNOSIS_MODEL=Qwen/Qwen2.5-14B-Instruct
JUDGE_MODEL=Qwen/Qwen2.5-72B-Instruct
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 判官独立网关（可选，默认复用 SILICONFLOW_BASE_URL）=====
# JUDGE_BASE_URL=

# ===== LLM 参数（可选）=====
# LLM_TEMPERATURE=0.1
# LLM_REQUEST_TIMEOUT=60
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF=1.5

# ===== 编排参数（可选）=====
# MAX_DEBATE_ROUNDS=3
# RETRIEVAL_K=3
# BM25_K=3
# RRF_K=60          # 混合检索 RRF 融合平滑系数，越大越弱化高排名优势

# ===== 成本规则（可选）=====
# LABOR_RATE_PER_HOUR=150
# PARTS_PRICE_JSON={"主轴轴承":850,"润滑脂":80,"冷却风扇":300}

# ===== 数据库 / 日志（可选）=====
# DB_PATH=diagnosis_history.db
# CHROMA_PERSIST_DIR=chroma_db
# LOG_LEVEL=INFO
# LOG_JSON=false

# ===== 服务端口（可选）=====
# API_HOST=0.0.0.0
# API_PORT=8000
# STREAMLIT_PORT=8501
# STREAMLIT_ADDRESS=0.0.0.0
# HEALTH_CACHE_TTL=60   # /health 结果缓存秒数，0 = 每次都真探（会反复调用 LLM）
# MAX_CONCURRENT_DIAGNOSES=4   # 同时在跑的诊断上限；超出的请求直接返回 503（而不是无声排队）

# ===== 安全（可选）=====
# API_KEY=              # 设置后业务接口需带 X-API-Key 请求头；留空则不做鉴权（本地开发默认）
# MAX_IMAGE_BASE64_CHARS=8000000   # 单张图片 base64 长度上限（约 6MB 原图）
